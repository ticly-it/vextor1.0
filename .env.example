# Chiave API Anthropic (obbligatoria)
ANTHROPIC_API_KEY=

# Nome dell'assistente (provvisorio, da cambiare quando il nome è deciso)
ASSISTANT_NAME=Ticly AI

# Porta del server
PORT=3000

# Chiave che i client devono inviare come "Authorization: Bearer <chiave>".
# Se vuota, l'API è aperta (solo per sviluppo locale).
TICLY_API_KEY=

# Profondità di ragionamento: low | medium | high | xhigh | max
EFFORT=medium

# Numero massimo di ricerche / pagine lette per risposta
MAX_SEARCHES=5
MAX_FETCHES=5
